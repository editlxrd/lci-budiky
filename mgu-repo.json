{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "exclude": [
      "_template",
      "wip",
      "ng_gsdash",
      "ng_spotify",
      "ng_tv"
    ],
    "mguHmi": [
      "ID7"
    ],
    "build": {
      "python": "kit/tools/build_lci.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz"
    }
  }
}
